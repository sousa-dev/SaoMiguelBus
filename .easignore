# NOTE: When .easignore exists, EAS uses it INSTEAD of .gitignore for the
# upload archive. It must therefore reproduce every .gitignore exclusion,
# plus the EAS-only excludes at the bottom.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Local Expo modules (modules/*) — Gradle/Xcode output only. The SOURCE in
# modules/ must stay tracked: autolinking discovers it at prebuild time, so a
# build that cannot see it silently ships without the native module.
modules/*/android/build/
modules/*/android/.gradle/
modules/*/ios/build/

# Legacy Android Studio project (src/android-project)
src/android-project/.gradle/
src/android-project/.idea/
src/android-project/**/build/
src/android-project/app/debug/
src/android-project/app/release/
src/android-project/local.properties

# Legacy Flutter project (src/saomiguelbus)
src/saomiguelbus/.dart_tool/
src/saomiguelbus/.idea/
src/saomiguelbus/.vscode/
src/saomiguelbus/build/
src/saomiguelbus/**/*.iml
src/saomiguelbus/pubspec.lock
src/saomiguelbus/pubspec*.lock
src/saomiguelbus/.flutter-plugins
src/saomiguelbus/.flutter-plugins-dependencies
src/saomiguelbus/android/.gradle/
src/saomiguelbus/android/local.properties
src/saomiguelbus/ios/Pods/
src/saomiguelbus/ios/Podfile.lock
src/saomiguelbus/macos/Pods/
src/saomiguelbus/macos/Podfile.lock
src/android-project/app/.idea/

android.keystore

# --- EAS-only excludes (not needed for the build) ---
#
# EVERY pattern below is anchored with a leading slash, and must stay that way.
# A trailing-slash-only pattern like `src/` is NOT root-relative in gitignore
# syntax — it matches a directory of that name at ANY depth. Unanchored `src/`
# stripped `modules/exact-alarm/android/src/` from the upload, which left
# autolinking to generate a reference to `ExactAlarmModule` whose source was no
# longer there:
#
#   e: ExpoModulesPackageList.kt:25:31 Unresolved reference 'ExactAlarmModule'
#   > Task :expo:compileReleaseKotlin FAILED
#
# It builds locally because .gitignore has no such pattern, so this fails only
# on EAS. Verify any change here with:
#   git ls-files --exclude-from=.easignore --ignored --cached

# Legacy native projects (not imported by the Expo app)
/src/
/legacy/

# Docs & specs
/docs/
/doc/
/SDD/
/MIGRATION_PLAN.md

# Tests (not needed in the build archive)
/__tests__/
