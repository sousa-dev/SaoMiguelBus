EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
EXPO_PUBLIC_ISLAND_KEY=sao-miguel
# Android maps use Leaflet + OSM/CARTO in a WebView — no Google Maps API key required.
# Optional override for legal pages (default https://saomiguelhub.com)
# EXPO_PUBLIC_LEGAL_BASE_URL=https://saomiguelhub.com
# Set to false to silence [SMB] dev logs in the Metro terminal
EXPO_PUBLIC_DEV_LOGS=true

# --- RevenueCat (in-app purchases) --- #
# Platform-specific PUBLIC SDK keys (Project settings → API keys → App specific).
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_xxxxxxxxxxxxxxxxxxxx
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_xxxxxxxxxxxxxxxxxxxx
# Test Store key — used ONLY in __DEV__ builds; never ship to production.
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=test_buMLLvzfAnCmaxAgqXrckBOBqoq
# Entitlement identifier — must exactly match the RevenueCat dashboard entitlement
# and whatever the backend webhook maps to premium. Defaults to "Sao Miguel Hub Premium".
# EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=Sao Miguel Hub Premium
# Optional tourist 7-day pass offering identifier — leave unset until the RC paywall exists.
# EXPO_PUBLIC_REVENUECAT_TOURIST_OFFERING_ID=tourist_7day
# Tourist one-time pass product IDs and duration in days (productId:days pairs).
# EXPO_PUBLIC_REVENUECAT_TOURIST_PASS_PRODUCTS=7_day_premium:7,15_days_premium:15
# Enable the RevenueCat Customer Center manage UI (requires a paid RC plan + dashboard config).
# EXPO_PUBLIC_REVENUECAT_CUSTOMER_CENTER=false
# NOTE: the webhook secret (REVENUECAT_WEBHOOK_SECRET) lives in the API repo only — never here.

# --- Google Sign-In (social auth) --- #
# OAuth 2.0 client IDs from Google Cloud Console. Setting ANY of these enables
# the native Google flow (features/account/components/SocialSignInButtons.tsx).
# The button also requires matching IDs in the API GOOGLE_OAUTH_CLIENT_IDS env;
# clearing that API var hides the button remotely (via /api/v3/bootstrap) without
# rebuilding the app. The id_token returned by expo-auth-session has the WEB client
# ID as its audience, so the web client is required even for Android. The Android
# client is registered with package name com.hsousa_apps.Autocarros + the release
# keystore SHA-1 fingerprint (get it via `eas credentials`).
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

